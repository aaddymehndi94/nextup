// nexttupp cloud: one Worker + one D1 database.
// Nothing here has been deployed. `wrangler deploy` and `wrangler d1 create` change the owner's Cloudflare
// account, so they wait for the owner's approval (see README.md, "Deploying").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttupp-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Creates a DNS record and certificate for api.nexttupp.com in the nexttupp.com zone on first deploy.
    { "pattern": "api.nexttupp.com", "custom_domain": true }
  ],
  "vars": {
    // The website. Invite links are <PUBLIC_URL>/join?code=nxi_…, a page the website serves. Reset links
    // use this Worker's own origin (api.nexttupp.com/reset#…).
    "PUBLIC_URL": "https://nexttupp.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexttupp",
      // Created on 2026-11-11 with `wrangler d1 create nexttupp`, after the owner approved the deploy.
      "database_id": "674a7ec2-3807-41f4-ba0e-860ceb7035db",
      "migrations_dir": "migrations"
    }
  ]
}

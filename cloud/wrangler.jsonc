// nexttupp cloud: one Worker + one D1 database.
// Nothing here has been deployed. `wrangler deploy` and `wrangler d1 create` change the owner's Cloudflare
// account, so they wait for the owner's approval (see README.md, "Deploying").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttupp-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Creates a DNS record and certificate for api.nexttupp.com in the nexttupp.com zone on first deploy.
    { "pattern": "api.nexttupp.com", "custom_domain": true }
  ],
  // Cloudflare Email Service, for sign-in codes (src/codes.ts). Needs the Workers Paid plan and nexttupp.com
  // onboarded under Email Service, Email Sending. `wrangler dev` and the tests don't send anything.
  "send_email": [{ "name": "EMAIL" }],
  // MIN_APP_VERSION and APP_NOTICE (src/index.ts) are set in the dashboard, Settings, Variables, so the owner
  // can change them without a deploy; keep_vars stops a deploy from wiping them.
  "keep_vars": true,
  "vars": {
    // "Continue with Google" (src/google.ts). The client ID is public; its secret is set with
    // `wrangler secret put GOOGLE_CLIENT_SECRET`, never here.
    "GOOGLE_CLIENT_ID": "490895467902-hc2340bocsar0str2isfj6ruikbn8doj.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexttupp",
      // Created on 2026-11-11 with `wrangler d1 create nexttupp`, after the owner approved the deploy.
      "database_id": "674a7ec2-3807-41f4-ba0e-860ceb7035db",
      "migrations_dir": "migrations"
    }
  ]
}

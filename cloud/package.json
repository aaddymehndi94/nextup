{
  "name": "nexttupp-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nexttupp accounts, invites and taste sync: one Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev --local --port 8799 --var PUBLIC_URL:http://localhost:8799",
    "db:migrate:local": "wrangler d1 migrations apply nexttupp --local",
    "bootstrap-invite": "node scripts/bootstrap-invite.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}

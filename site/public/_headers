# Headers for the files served without the Worker (fonts, images, icons, scripts, styles): see
# run_worker_first in wrangler.jsonc. Pages still go through src/worker.js, which sets the CSP and the rest.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=604800

# The TV app (nexttupp.com/tv): always the newest, saved as a file wherever it's opened.
/tv.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="nexttupp-tv.apk"
  Cache-Control: no-cache

/img/*
  Cache-Control: public, max-age=604800

# The phone app's service worker: always checked for a new version. A worker's own fetches follow the CSP sent
# with its script, so it gets one that lets it fetch this site's files (to keep /watch for offline).
/watch-sw.js
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'none'; connect-src 'self'

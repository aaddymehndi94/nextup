{
  "name": "nexttupp",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:cf": "python3 -I scripts/build-cf.py build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "lucide-react": "^1.71.0",
    "multicast-dns": "7.2.5",
    "openai": "7.45.1",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "puppeteer-core": "^25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
